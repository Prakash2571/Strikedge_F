{
  "name": "strikedge_frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "contract:verify": "node contract/verify.mjs",
    "contract:types": "node contract/generate-types.mjs",
    "contract:types:check": "node contract/generate-types.mjs && git diff --exit-code -- src/api/contract.generated.ts",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
